/* ==========================================================================
   Design System & Root Variables (Mobile First)
   ========================================================================== */
:root {
    --font-primary: 'Noto Sans JP', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-heading: 'Orbitron', 'Noto Sans JP', sans-serif;

    /* Palette */
    --bg-dark: #070a12;
    --text-main: #f0f4f8;
    --text-muted: #94a3b8;
    
    /* Neon Accents */
    --accent-blue: #00d2ff;
    --accent-purple: #9d4edd;
    --accent-pink: #ff2a85;
    
    /* Glassmorphism Tokens */
    --glass-bg: rgba(255, 255, 255, 0.05);
    --glass-border: rgba(255, 255, 255, 0.12);
    --glass-hover-bg: rgba(255, 255, 255, 0.12);
    --glass-backdrop: blur(16px);
    --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);

    /* Transitions */
    --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-medium: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Reset & Basic Styles */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

body {
    font-family: var(--font-primary);
    background-color: var(--bg-dark);
    color: var(--text-main);
    line-height: 1.6;
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
}

/* ==========================================================================
   Background Video & Overlay (Bright/Darkness Control)
   ========================================================================== */
.video-background-container {
    position: absolute;
    top: 75px; /* ヘッダーと被らないよう下部に配置 */
    left: 5%;  /* 幅90%に合わせて左右中央寄せ (100% - 90%) / 2 */
    width: 90%;
    height: 80vh; /* 画面高さの約90%相当（ヘッダー分を考慮した90%領域） */
    z-index: -2;
    overflow: hidden;
    border-radius: 20px; /* 枠組みをモダンに角丸化 */
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8), 0 0 20px rgba(0, 210, 255, 0.2);
    border: 1px solid var(--glass-border);
}

.bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.65) contrast(1.1); /* 動画自体の明度・コントラストを調整 */
}

/* 動画の明度を下げるダークオーバーレイ */
.video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background: radial-gradient(
        circle at center,
        rgba(7, 10, 18, 0.5) 0%,
        rgba(5, 7, 14, 0.8) 75%,
        rgba(2, 3, 8, 0.92) 100%
    );
    pointer-events: none;
    border-radius: inherit;
}

/* Container */
.container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
}

/* ==========================================================================
   Header & Navigation (Glassmorphism)
   ========================================================================== */
.site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: rgba(7, 10, 18, 0.65);
    backdrop-filter: var(--glass-backdrop);
    -webkit-backdrop-filter: var(--glass-backdrop);
    border-bottom: 1px solid var(--glass-border);
    transition: var(--transition-medium);
}

.header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    max-width: 1200px;
    margin: 0 auto;
}

.logo {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--text-main);
    text-decoration: none;
    letter-spacing: 0.1em;
}

.logo-accent {
    color: var(--accent-blue);
    text-shadow: 0 0 12px rgba(0, 210, 255, 0.6);
}

.main-nav ul {
    display: flex;
    list-style: none;
    gap: 1.25rem;
}

.main-nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.4rem 0.75rem;
    border-radius: 20px;
    transition: var(--transition-fast);
}

.main-nav a:hover,
.main-nav a.active {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 10px rgba(0, 210, 255, 0.2);
}

/* ==========================================================================
   Hero Section
   ========================================================================== */
.hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 7rem 1.25rem 4rem;
    text-align: center;
    position: relative;
}

.hero-content {
    max-width: 800px;
    margin: 0 auto;
}

.badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--accent-blue);
    background: rgba(0, 210, 255, 0.1);
    border: 1px solid rgba(0, 210, 255, 0.3);
    padding: 0.35rem 1rem;
    border-radius: 50px;
    margin-bottom: 1.5rem;
    box-shadow: 0 0 15px rgba(0, 210, 255, 0.2);
}

.hero-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 900;
    line-height: 1.3;
    margin-bottom: 1.25rem;
    background: linear-gradient(135deg, #ffffff 0%, #a5f3fc 50%, var(--accent-blue) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}

.hero-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 2.25rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
}

.hero-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
    align-items: center;
}

/* ==========================================================================
   Buttons
   ========================================================================== */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 50px;
    cursor: pointer;
    text-decoration: none;
    transition: var(--transition-medium);
    border: none;
    width: 100%;
    max-width: 280px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-purple) 100%);
    color: #ffffff;
    box-shadow: 0 0 20px rgba(0, 210, 255, 0.4);
    position: relative;
    z-index: 1;
    overflow: hidden;
}

.btn-primary::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(135deg, var(--accent-pink) 0%, var(--accent-blue) 100%);
    opacity: 0;
    z-index: -1;
    transition: var(--transition-medium);
}

.btn-primary:hover::before {
    opacity: 1;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 30px rgba(255, 42, 133, 0.6);
}

.btn-glass {
    background: var(--glass-bg);
    color: var(--text-main);
    border: 1px solid var(--glass-border);
    backdrop-filter: var(--glass-backdrop);
    -webkit-backdrop-filter: var(--glass-backdrop);
}

.btn-glass:hover {
    background: var(--glass-hover-bg);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
}

.btn-sm {
    padding: 0.5rem 1.25rem;
    font-size: 0.875rem;
    width: auto;
}

/* ==========================================================================
   Features Section
   ========================================================================== */
.features-section {
    padding: 5rem 0;
    position: relative;
}

.section-title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    text-align: center;
    margin-bottom: 0.75rem;
    color: #ffffff;
}

.section-description {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: 3rem;
    font-size: 0.95rem;
}

.features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
}

.feature-card {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    backdrop-filter: var(--glass-backdrop);
    -webkit-backdrop-filter: var(--glass-backdrop);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    box-shadow: var(--glass-shadow);
    transition: var(--transition-medium);
}

.feature-card:hover {
    transform: translateY(-5px);
    background: var(--glass-hover-bg);
    border-color: rgba(0, 210, 255, 0.4);
    box-shadow: 0 12px 40px rgba(0, 210, 255, 0.15);
}

.card-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
}

.feature-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
    color: #ffffff;
}

.feature-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
}

/* ==========================================================================
   Footer
   ========================================================================== */
.site-footer {
    padding: 2.5rem 1.25rem;
    text-align: center;
    border-top: 1px solid var(--glass-border);
    background: rgba(5, 7, 14, 0.8);
    backdrop-filter: var(--glass-backdrop);
    color: var(--text-muted);
    font-size: 0.85rem;
}

/* ==========================================================================
   Glass Modal Dialog
   ========================================================================== */
.glass-modal {
    margin: auto;
    padding: 0;
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    background: rgba(12, 17, 32, 0.9);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    color: var(--text-main);
    max-width: 500px;
    width: 90%;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
}

.glass-modal::backdrop {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(5px);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--glass-border);
}

.modal-header h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
}

.close-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
    transition: var(--transition-fast);
}

.close-btn:hover {
    color: #ffffff;
}

.modal-body {
    padding: 1.5rem;
}

.modal-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent-pink), var(--accent-purple));
    color: white;
    padding: 0.2rem 0.6rem;
    border-radius: 10px;
    margin-bottom: 0.75rem;
}

.modal-body h4 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: var(--accent-blue);
}

.modal-body p {
    font-size: 0.9rem;
    color: var(--text-muted);
}

.modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--glass-border);
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
}

/* ==========================================================================
   Media Queries (Desktop Optimization)
   ========================================================================== */
@media (min-width: 768px) {
    .logo {
        font-size: 1.5rem;
    }

    .hero-title {
        font-size: 3.25rem;
    }

    .hero-subtitle {
        font-size: 1.2rem;
    }

    .hero-actions {
        flex-direction: row;
    }

    .btn {
        width: auto;
    }

    .features-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    .section-title {
        font-size: 2.25rem;
    }

    .section-description {
        font-size: 1.1rem;
    }
}